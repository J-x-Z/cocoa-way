#!/bin/sh
set -u

log() {
    printf '%s\n' "cocoa-way clipboard relay: $*" >&2
}

read_selection() {
    source=$1
    data_file=$2
    # Drain the watch pipe before querying its compositor again. Older wl-paste
    # versions do not expose CLIPBOARD_TYPE, so query the offered types explicitly.
    timeout 10 head -c 67108865 >"$data_file" || return 1
    # Nested compositors often announce an empty selection at startup. Do not
    # let that erase a valid host clipboard before both watchers are ready.
    [ -s "$data_file" ] || return 1
    [ "$(wc -c <"$data_file")" -le 67108864 ] || return 1
    types=$(WAYLAND_DISPLAY="$source" timeout 3 wl-paste --list-types) || return 1
    mime=
    for candidate in image/png 'text/plain;charset=utf-8' 'text/plain;charset=UTF-8' text/plain UTF8_STRING TEXT STRING; do
        if printf '%s\n' "$types" | grep -Fxq "$candidate"; then
            mime=$candidate
            break
        fi
    done
    # HTML is not plain text. Never copy markup under a text/plain label.
    [ -n "$mime" ] || return 1
    if [ "${CLIPBOARD_TYPE:-}" != "$mime" ]; then
        # ulimit bounds output even if a misbehaving source never closes its pipe.
        (ulimit -f 131072; WAYLAND_DISPLAY="$source" timeout 10 wl-paste --no-newline --type "$mime" >"$data_file") || return 1
    fi
    [ -s "$data_file" ] || return 1
    [ "$(wc -c <"$data_file")" -le 67108864 ] || return 1
    digest="$mime:$(cksum <"$data_file" | awk '{ print $1 ":" $2 }')"
}

transfer() {
    source=$1
    destination=$2
    state_file=$3
    data_file=$(mktemp) || exit 0
    trap 'rm -f "$data_file"' EXIT
    digest=
    if ! read_selection "$source" "$data_file"; then
        # An unrelayable selection changes this endpoint, not the other one.
        digest=
    fi

    lock_dir="${state_file}.lock"
    attempts=0
    while ! mkdir "$lock_dir" 2>/dev/null; do
        attempts=$((attempts + 1))
        [ "$attempts" -lt 50 ] || exit 0
        sleep 0.01
    done
    trap 'rmdir "$lock_dir" 2>/dev/null; rm -f "$data_file"' EXIT

    previous_source=
    previous_source_digest=
    previous_destination=
    previous_destination_digest=
    if [ -r "$state_file" ]; then
        {
            IFS= read -r previous_source || true
            IFS= read -r previous_source_digest || true
            IFS= read -r previous_destination || true
            IFS= read -r previous_destination_digest || true
        } <"$state_file"
    fi

    destination_digest=
    if [ "$previous_source" = "$source" ] && [ "$previous_destination" = "$destination" ]; then
        destination_digest=$previous_destination_digest
    elif [ "$previous_source" = "$destination" ] && [ "$previous_destination" = "$source" ]; then
        destination_digest=$previous_source_digest
    fi
    # Deduplicate only against this destination's current selection. Remember a
    # successful copy on both endpoints so its reverse watch callback is an echo.
    if [ -n "$digest" ] && [ "$destination_digest" != "$digest" ]; then
        # wl-copy normally forks once it owns the selection; wait for that handshake.
        if WAYLAND_DISPLAY="$destination" timeout 3 wl-copy --type "$mime" <"$data_file"; then
            destination_digest=$digest
        fi
    fi
    printf '%s\n' "$source" "$digest" "$destination" "$destination_digest" >"$state_file"
}

if [ "${1:-}" = "--transfer" ]; then
    shift
    transfer "$@"
    exit
fi

outer_display=${WAYLAND_DISPLAY:-wayland-0}
"$@" &
application_pid=$!

inner_display=
attempts=0
while [ "$attempts" -lt 100 ] && kill -0 "$application_pid" 2>/dev/null; do
    for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
        [ -S "$socket" ] || continue
        candidate=${socket##*/}
        [ "$candidate" = "$outer_display" ] && continue
        case "$candidate" in
            wayland-proxy-*) continue ;;
        esac
        inner_display=$candidate
        break
    done
    [ -n "$inner_display" ] && break
    attempts=$((attempts + 1))
    sleep 0.05
done

if [ -n "$inner_display" ]; then
    state_file=$(mktemp "$XDG_RUNTIME_DIR/cocoa-way-clipboard.XXXXXX")
    log "bridging $outer_display <-> $inner_display"

    start_outer_watcher() {
        WAYLAND_DISPLAY="$outer_display" wl-paste --watch \
            "$0" --transfer "$outer_display" "$inner_display" "$state_file" &
        outer_watcher=$!
    }

    start_inner_watcher() {
        WAYLAND_DISPLAY="$inner_display" wl-paste --watch \
            "$0" --transfer "$inner_display" "$outer_display" "$state_file" &
        inner_watcher=$!
    }

    supervise_watchers() {
        start_outer_watcher
        start_inner_watcher
        trap 'kill "$outer_watcher" "$inner_watcher" 2>/dev/null || true' EXIT INT TERM

        while kill -0 "$application_pid" 2>/dev/null; do
            if ! kill -0 "$outer_watcher" 2>/dev/null; then
                wait "$outer_watcher" 2>/dev/null || true
                log "outer watcher exited; restarting"
                start_outer_watcher
            fi
            if ! kill -0 "$inner_watcher" 2>/dev/null; then
                wait "$inner_watcher" 2>/dev/null || true
                log "inner watcher exited; restarting"
                start_inner_watcher
            fi
            sleep 0.25
        done
    }

    supervise_watchers &
    watcher_supervisor=$!
else
    log "nested compositor display was not found; clipboard bridge is disabled"
fi

wait "$application_pid"
status=$?
[ -z "${watcher_supervisor:-}" ] || kill "$watcher_supervisor" 2>/dev/null || true
[ -z "${watcher_supervisor:-}" ] || wait "$watcher_supervisor" 2>/dev/null || true
[ -z "${state_file:-}" ] || rm -f "$state_file"
exit "$status"
